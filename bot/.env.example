# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=

# LLM — рекомендуются мировые провайдеры (OpenAI-совместимые API):
#   OpenRouter (бесплатные модели): LLM_BASE_URL=https://openrouter.ai/api/v1, model=meta-llama/llama-3.3-70b-instruct:free
#   Groq (бесплатный тир):           LLM_BASE_URL=https://api.groq.com/openai/v1,   model=llama-3.3-70b-versatile
#   DeepSeek:                        LLM_BASE_URL=https://api.deepseek.com/v1,      model=deepseek-chat
# Если ключ пуст — включится демо-режим (заглушка вместо маршрута).
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# GigaChat (Сбер, работает из РФ) — запасной вариант, по умолчанию выключен.
# Нужен только если LLM_PROVIDER=gigachat (или auto + заполнены оба поля).
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_MODEL=GigaChat-Pro

# Партнёрские идентификаторы (для монетизации)
AVIASALES_MARKER=
OSTROVOK_PARTNER_ID=

# Реальные цены на авиа (Travelpayouts / Aviasales) — получить после верификации
# на https://www.travelpayouts.com/ (раздел «API»)
TRAVELPAYOUTS_TOKEN=

# Telegram Payments. Получите PRODUCTION-токен у @BotFather (мой бот -> Payments)
# через ЮKassa/СБП. Пустое значение = оплата отключена (демо-режим).
PAYMENTS_PROVIDER_TOKEN=
PRICE_PER_TRIP_RUB=690

# Каталог для кэша данных (IATA) — необязательно, по умолчанию system temp
CACHE_DIR=
